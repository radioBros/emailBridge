{
  "name": "@emailbridge/sdk",
  "version": "1.0.0",
  "description": "EmailBridge TypeScript SDK — typed API client, webhook verifier, SSE helper",
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node ./scripts/generate.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "keywords": [],
  "author": ""
}
