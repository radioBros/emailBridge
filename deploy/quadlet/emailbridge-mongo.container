[Unit]
Description=EmailBridge MongoDB (replica set rs0)
After=network-online.target

[Container]
Image=docker.io/library/mongo:8.0.15
# Entrypoint copies the keyFile to a trusted mode then starts mongod (no init container).
Entrypoint=["bash","-ec","install -m 0400 -o 999 -g 999 /run/secrets/mongo_keyfile /tmp/keyfile; exec docker-entrypoint.sh mongod --replSet rs0 --bind_ip_all --keyFile /tmp/keyfile --auth"]
Environment=MONGO_INITDB_ROOT_USERNAME=root
Environment=MONGO_INITDB_ROOT_PASSWORD_FILE=/run/secrets/mongo_root_password
Environment=MONGO_INITDB_DATABASE=emailbridge
Volume=%h/.local/share/emailbridge/mongo:/data/db:Z
Secret=mongo_keyfile,type=mount,target=mongo_keyfile
Secret=mongo_root_password,type=mount,target=mongo_root_password
Network=emailbridge.network
HealthCmd=mongosh -u root -p "$(cat /run/secrets/mongo_root_password)" --authenticationDatabase admin --quiet --eval "try { rs.status().ok } catch (e) { rs.initiate({_id:'rs0',members:[{_id:0,host:'emailbridge-mongo:27017'}]}).ok }"
HealthInterval=5s
HealthTimeout=10s
HealthRetries=30
HealthStartPeriod=15s
AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=default.target
