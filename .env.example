# Copy to .env.test.local (gitignored) and fill in. Never commit real values.

# Optional live test mailbox (normal email). Live tests send ONLY to this mailbox itself.
EB_TEST_MAIL_HOST=mail.example.com
EB_TEST_IMAP_PORT=993
EB_TEST_SMTP_PORT=465
EB_TEST_POP3_PORT=995
EB_TEST_MAIL_USER=
EB_TEST_MAIL_PASS=

# Optional error-reporting test target (any Sentry-compatible DSN, e.g. GlitchTip)
EB_TEST_SENTRY_DSN=

# Optional SSO test (any OIDC provider, e.g. Authentik or Keycloak)
EB_TEST_OIDC_ISSUER=
EB_TEST_OIDC_CLIENT_ID=
EB_TEST_OIDC_CLIENT_SECRET=
