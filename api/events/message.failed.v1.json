  "properties": {
    "accountId": {
      "description": "Account ID (acc_…)",
      "type": "string"
    },
    "attempts": {
      "description": "Attempts made",
      "format": "int64",
      "type": "integer"
    },
    "envelope": {
      "$ref": "#/$defs/Envelope",
      "description": "SMTP envelope"
    },
    "error": {
      "$ref": "#/$defs/SendError",
      "description": "Error of the last attempt"
    },
    "externalId": {
      "description": "Caller-supplied external ID, or null",
      "type": [
        "string",
        "null"
      ]
    },
    "messageIdHeader": {
      "description": "Message-ID header of the sent message",
      "type": "string"
    },
    "outboundId": {
      "description": "Outbound ID (out_…)",
      "type": "string"
    },
    "outcomeUnknown": {
      "description": "No final reply after DATA under atMostOnce",
      "type": "boolean"
    },
    "subject": {
