{
  "$defs": {
    "Envelope": {
      "properties": {
        "from": {
          "description": "SMTP MAIL FROM address",
          "type": "string"
        },
        "to": {
          "description": "SMTP RCPT TO addresses",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "SendError": {
      "properties": {
        "code": {
          "description": "Problem code, e.g. smtp_permanent, smtp_temporary or mail_connect_failed",
          "type": "string"
        },
        "enhanced": {
          "description": "Enhanced status code (RFC 3463)",
          "type": "string"
        },
        "kind": {
          "description": "Error kind (S0 error model): temporary, permanent, rate_limited or outcome_unknown",
          "type": "string"
        },
        "response": {
          "description": "Redacted server reply",
          "type": "string"
        },
        "smtpCode": {
          "description": "SMTP reply code, when the server answered",
          "format": "int64",
          "type": "integer"
        },
        "stage": {
          "description": "SMTP stage that failed",
          "enum": [
            "connect",
            "ehlo",
            "auth",
            "mailFrom",
            "rcptTo",
            "data",
            "dataEnd"
          ],
          "type": "string"
        }
      },
      "required": [
        "code",
        "kind",
        "stage"
      ],
      "type": "object"
    }
  },
  "$id": "https://emailbridge.dev/schemas/events/message.failed/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
