{
  "$defs": {
    "Address": {
      "properties": {
        "address": {
          "description": "E-mail address",
          "type": "string"
        },
        "name": {
          "description": "Display name",
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "AttachmentInfo": {
      "properties": {
        "contentId": {
          "description": "Content-ID for inline parts",
          "type": "string"
        },
        "contentType": {
          "description": "MIME type of the part",
          "type": "string"
        },
        "disposition": {
          "description": "attachment or inline",
          "type": "string"
        },
        "filename": {
          "description": "File name from the MIME part",
          "type": "string"
        },
        "id": {
          "description": "Attachment ID (att_…)",
          "type": "string"
        },
        "partId": {
          "description": "MIME part number (e.g. 2 or 1.2)",
          "type": "string"
        },
        "scan": {
          "description": "Malware scan result: clean, infected, error or skipped",
          "type": "string"
        },
        "size": {
          "description": "Decoded size in bytes",
          "format": "int64",
          "type": "integer"
        },
        "url": {
          "description": "Signed download URL, when attachments are stored in object storage",
          "type": "string"
        }
      },
      "required": [
        "contentType",
        "size",
        "partId"
      ],
      "type": "object"
    },
    "AuthResult": {
      "properties": {
        "domain": {
          "description": "Domain that was checked",
          "type": "string"
        },
        "result": {
          "description": "Verdict: pass, fail, softfail, neutral, none, temperror or permerror",
          "type": "string"
        },
        "selector": {
          "description": "DKIM selector",
          "type": "string"
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "AuthResults": {
      "properties": {
        "arc": {
          "$ref": "#/$defs/AuthResult",
          "description": "ARC chain verdict"
        },
        "dkim": {
          "description": "One verdict per DKIM signature",
          "items": {
            "$ref": "#/$defs/AuthResult"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "dmarc": {
          "$ref": "#/$defs/AuthResult",
          "description": "DMARC verdict"
        },
        "source": {
          "description": "header: taken from Authentication-Results; verify: computed by EmailBridge",
          "enum": [
            "header",
            "verify"
          ],
          "type": "string"
        },
        "spf": {
          "$ref": "#/$defs/AuthResult",
          "description": "SPF verdict"
        }
      },
      "required": [
        "dkim",
        "source"
      ],
      "type": "object"
    },
    "BounceInfo": {
      "properties": {
        "bounceType": {
          "description": "hard | soft",
          "type": "string"
        },
        "kind": {
          "description": "dsn_bounce | heuristic_bounce | complaint | challenge_response",
          "type": "string"
        },
        "originalMessageId": {
          "description": "Message-ID of the original message",
          "type": "string"
        },
        "outboundId": {
          "description": "The outbound message it refers to, when correlated",
          "type": "string"
        },
        "recipients": {
          "description": "Per-recipient rows of the DSN",
          "items": {
            "$ref": "#/$defs/BounceRecipient"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "BounceRecipient": {
      "properties": {
        "action": {
          "description": "DSN action: failed, delayed, delivered, relayed or expanded",
          "type": "string"
        },
        "address": {
          "description": "Recipient that bounced",
          "type": "string"
        },
        "bounceType": {
          "description": "hard or soft",
          "type": "string"
        },
        "diagnostic": {
          "description": "Remote diagnostic, at most 512 characters",
          "type": "string"
        },
        "status": {
          "description": "Enhanced status code, e.g. 5.1.1",
          "type": "string"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "CalendarEvent": {
      "properties": {
        "attendees": {
          "description": "Attendees",
          "items": {
            "$ref": "#/$defs/CalendarPerson"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "dtEnd": {
          "$ref": "#/$defs/CalendarTime",
          "description": "End"
        },
        "dtStart": {
          "$ref": "#/$defs/CalendarTime",
          "description": "Start"
        },
        "method": {
          "description": "iTIP method of the calendar: REQUEST, REPLY, CANCEL, PUBLISH …",
          "type": "string"
        },
        "organizer": {
          "$ref": "#/$defs/CalendarPerson",
          "description": "Organizer"
        },
        "rrule": {
          "description": "Recurrence rule (RFC 5545 RRULE)",
          "type": "string"
        },
        "sequence": {
          "description": "Revision number (SEQUENCE)",
          "format": "int64",
          "type": "integer"
        },
        "status": {
          "description": "TENTATIVE, CONFIRMED or CANCELLED",
          "type": "string"
        },
        "summary": {
          "description": "Event title",
          "type": "string"
        },
        "uid": {
          "description": "Event UID",
          "type": "string"
        }
      },
      "required": [
        "uid",
        "sequence"
      ],
      "type": "object"
    },
    "CalendarPerson": {
      "properties": {
        "address": {
          "description": "E-mail address",
          "type": "string"
        },
        "name": {
          "description": "Common name (CN)",
          "type": "string"
        },
        "partStat": {
          "description": "Participation status, e.g. ACCEPTED or NEEDS-ACTION",
          "type": "string"
        },
        "role": {
          "description": "Role, e.g. REQ-PARTICIPANT",
          "type": "string"
        },
        "rsvp": {
          "description": "The organizer asks for a reply (RSVP=TRUE)",
          "type": "boolean"
        }
      },
      "required": [
        "address"
      ],
      "type": "object"
    },
    "CalendarTime": {
      "properties": {
        "allDay": {
          "description": "All-day event (a DATE value)",
          "type": "boolean"
        },
        "dateTime": {
          "description": "Date and time (UTC)",
          "format": "date-time",
          "type": "string"
        },
        "timeZone": {
          "description": "Original TZID",
          "type": "string"
        }
      },
      "required": [
        "dateTime"
      ],
      "type": "object"
    },
    "Mailbox": {
      "properties": {
        "mailboxId": {
          "description": "Mailbox ID (mbx_…)",
          "type": "string"
        },
        "path": {
          "description": "Folder path as on the server",
          "type": "string"
        },
        "specialUse": {
          "description": "RFC 6154 special use (\\\\Sent, \\\\Trash, …)",
          "type": "string"
        }
      },
      "required": [
        "mailboxId",
        "path"
      ],
      "type": "object"
    },
    "PECInfo": {
      "properties": {
        "deliveredTo": {
          "description": "Recipient the receipt confirms",
          "type": "string"
        },
        "error": {
          "description": "daticert errore (nessuno = none)",
          "type": "string"
        },
        "kind": {
          "description": "envelope: a certified message (busta di trasporto); anomaly: busta di anomalia; receipt: a PEC receipt",
          "enum": [
            "envelope",
            "anomaly",
            "receipt"
          ],
          "type": "string"
        },
        "originalMessageId": {
          "description": "Message-ID of the original message",
          "type": "string"
        },
        "parseError": {
          "description": "Why daticert.xml could not be parsed, when it could not",
          "type": "string"
        },
        "receiptId": {
          "description": "rcp_… for receipts",
          "type": "string"
        },
        "receiptKind": {
          "description": "Receipt variant requested by the sender",
          "enum": [
            "completa",
            "breve",
            "sintetica"
          ],
          "type": "string"
        },
        "signature": {
          "$ref": "#/$defs/PECSignature",
          "description": "S/MIME check of the PEC message"
        },
        "transportId": {
          "description": "PEC transport identifier (identificativo)",
          "type": "string"
        },
        "type": {
          "description": "X-Ricevuta / X-Trasporto value, e.g. accettazione, avvenuta-consegna, posta-certificata",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "type",
        "signature"
      ],
      "type": "object"
    },
    "PECSignature": {
      "properties": {
        "trusted": {
          "description": "Signer chains to a configured trust anchor; null when no anchors are configured",
          "type": [
            "boolean",
            "null"
          ]
        },
        "valid": {
          "description": "The S/MIME signature verifies",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "trusted"
      ],
      "type": "object"
    },
    "SpamInfo": {
      "properties": {
        "action": {
          "description": "Rspamd action, e.g. no action, add header, reject",
          "type": "string"
        },
        "score": {
          "description": "Rspamd score",
          "format": "double",
          "type": "number"
        },
        "symbols": {
          "additionalProperties": {
            "format": "double",
            "type": "number"
          },
          "description": "Matched Rspamd symbols with their scores",
          "type": "object"
        }
      },
      "required": [
        "score"
      ],
      "type": "object"
    },
    "TextContent": {
      "properties": {
        "html": {
          "description": "HTML body, when the endpoint asked for it",
          "type": "string"
        },
        "plain": {
          "description": "Plain-text body, when the endpoint asked for it",
          "type": "string"
        },
        "size": {
          "description": "Size of the full text in bytes before truncation",
          "format": "int64",
          "type": "integer"
        },
        "truncated": {
          "description": "True when a body was cut at the endpoint's text limit",
          "type": "boolean"
        }
      },
      "required": [
        "truncated",
        "size"
      ],
      "type": "object"
    }
  },
