  "properties": {
    "accountId": {
      "description": "Account ID (acc_…)",
      "type": "string"
    },
    "attachments": {
      "description": "Attachment metadata, when the endpoint's payload options include it",
      "items": {
        "$ref": "#/$defs/AttachmentInfo"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "authResults": {
      "$ref": "#/$defs/AuthResults",
      "description": "SPF, DKIM, DMARC and ARC results"
    },
    "bcc": {
      "description": "Bcc recipients (only on messages the account sent)",
      "items": {
        "$ref": "#/$defs/Address"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "bounce": {
      "$ref": "#/$defs/BounceInfo",
      "description": "Bounce or complaint classification, inbound.bounceDetection on (P5)"
    },
    "calendarEvents": {
      "description": "Parsed text/calendar parts (P4): invitations, updates, cancellations",
      "items": {
        "$ref": "#/$defs/CalendarEvent"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "cc": {
      "description": "Cc recipients",
      "items": {
        "$ref": "#/$defs/Address"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "date": {
      "description": "Date header, null if unparsable",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "emailId": {
      "description": "Stable message identity across folders (Gmail X-GM-MSGID or a content hash)",
      "type": "string"
    },
    "externalId": {
      "description": "Caller-supplied external ID, or null",
      "type": [
        "string",
        "null"
      ]
    },
    "flags": {
      "description": "IMAP flags",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "from": {
      "$ref": "#/$defs/Address",
      "description": "From address; null when missing"
    },
    "headers": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "type": [
          "array",
          "null"
        ]
      },
      "description": "Lower-cased header names the endpoint asked for",
      "type": "object"
    },
    "inReplyTo": {
      "description": "In-Reply-To header",
      "type": "string"
    },
    "internalDate": {
      "description": "IMAP INTERNALDATE (when the server received the message)",
      "format": "date-time",
      "type": "string"
    },
    "isAutoReply": {
      "description": "Automatic reply (RFC 3834, out-of-office), inbound.bounceDetection on (P5)",
      "type": "boolean"
    },
    "labels": {
      "description": "Gmail labels (empty on other servers)",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "mailbox": {
      "$ref": "#/$defs/Mailbox",
      "description": "Folder the message arrived in"
    },
    "messageId": {
      "description": "Our ID (msg_…)",
      "type": "string"
    },
    "messageIdHeader": {
      "description": "Message-ID header, unchanged",
      "type": "string"
    },
    "pec": {
      "$ref": "#/$defs/PECInfo",
      "description": "PEC envelope or receipt, pec.enabled accounts (P9, S17 §4)"
    },
    "references": {
      "description": "Message-IDs of the References header",
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "replyText": {
      "description": "New reply text with quoted history stripped (P4.2 / W48)",
      "type": "string"
    },
    "replyTo": {
      "description": "Reply-To addresses",
      "items": {
        "$ref": "#/$defs/Address"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "seenBefore": {
      "description": "Same emailId already exists in another folder (a move)",
      "type": "boolean"
    },
    "sender": {
      "$ref": "#/$defs/Address",
      "description": "Sender header, when different from From"
    },
    "size": {
      "description": "RFC 822 size in bytes",
      "format": "int64",
      "type": "integer"
    },
    "spam": {
      "$ref": "#/$defs/SpamInfo",
      "description": "Rspamd score/action/symbols when integrations.rspamd is on (P8.3)"
    },
    "subject": {
      "description": "Decoded Subject header",
      "type": "string"
    },
    "text": {
      "$ref": "#/$defs/TextContent",
      "description": "Message text, when the endpoint's payload options include it"
    },
    "threadId": {
      "description": "Conversation ID",
      "type": "string"
    },
    "to": {
      "description": "To recipients",
      "items": {
        "$ref": "#/$defs/Address"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "uid": {
      "description": "IMAP UID in the folder",
      "format": "int32",
      "minimum": 0,
