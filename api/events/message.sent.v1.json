  "properties": {
    "accountId": {
      "description": "Account ID (acc_…)",
      "type": "string"
    },
    "attempt": {
      "description": "Attempt number that succeeded (1 = first try)",
      "format": "int64",
      "type": "integer"
    },
    "envelope": {
      "$ref": "#/$defs/Envelope",
      "description": "SMTP envelope"
    },
    "externalId": {
      "description": "Caller-supplied external ID, or null",
      "type": [
        "string",
        "null"
      ]
    },
    "gatewayId": {
      "description": "P5",
      "type": "string"
    },
    "messageIdHeader": {
      "description": "Message-ID header of the sent message",
      "type": "string"
    },
    "outboundId": {
      "description": "Outbound ID (out_…)",
      "type": "string"
    },
    "rejected": {
      "description": "Recipients refused while the others were accepted",
      "items": {
        "$ref": "#/$defs/Rejection"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "sentAt": {
      "description": "When the server accepted the message",
      "format": "date-time",
      "type": "string"
    },
    "smtp": {
      "$ref": "#/$defs/SMTPReply",
      "description": "Final SMTP reply"
    },
    "subject": {
      "description": "Subject of the message",
      "type": "string"
    }
  },
  "required": [
    "sentAt",
    "attempt",
    "smtp",
    "outboundId",
    "messageIdHeader",
    "envelope",
    "subject",
    "accountId",
    "externalId"
  ],
  "title": "message.sent data (v1)",
  "type": "object"
}
