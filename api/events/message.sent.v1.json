{
  "$defs": {
    "Envelope": {
      "properties": {
        "from": {
          "description": "SMTP MAIL FROM address",
          "type": "string"
        },
        "to": {
          "description": "SMTP RCPT TO addresses",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "type": "object"
    },
    "Rejection": {
      "properties": {
        "address": {
          "description": "Refused recipient",
          "type": "string"
        },
        "code": {
          "description": "SMTP reply code",
          "format": "int64",
          "type": "integer"
        },
        "enhanced": {
          "description": "Enhanced status code (RFC 3463)",
          "type": "string"
        },
        "message": {
          "description": "Server reply text",
          "type": "string"
        }
      },
      "required": [
        "address",
        "code",
        "message"
      ],
      "type": "object"
    },
    "SMTPReply": {
      "properties": {
        "code": {
          "description": "SMTP reply code",
          "format": "int64",
          "type": "integer"
        },
        "enhanced": {
          "description": "Enhanced status code (RFC 3463)",
          "type": "string"
        },
        "host": {
          "description": "SMTP server that answered",
          "type": "string"
        },
        "response": {
          "description": "Server reply text",
          "type": "string"
        }
      },
      "required": [
        "host",
        "code",
        "response"
      ],
      "type": "object"
    }
  },
  "$id": "https://emailbridge.dev/schemas/events/message.sent/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
    {
