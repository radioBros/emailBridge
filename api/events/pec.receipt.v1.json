{
  "$defs": {
    "PECRecipient": {
      "properties": {
        "address": {
          "description": "Recipient address",
          "type": "string"
        },
        "kind": {
          "description": "certificato: a PEC mailbox; esterno: a normal mailbox",
          "enum": [
            "certificato",
            "esterno"
          ],
          "type": "string"
        }
      },
      "required": [
        "address",
        "kind"
      ],
      "type": "object"
    },
    "PECSignature": {
      "properties": {
        "trusted": {
          "description": "Signer chains to a configured trust anchor; null when no anchors are configured",
          "type": [
            "boolean",
            "null"
          ]
        },
        "valid": {
          "description": "The S/MIME signature verifies",
          "type": "boolean"
        }
      },
      "required": [
        "valid",
        "trusted"
      ],
      "type": "object"
    }
  },
