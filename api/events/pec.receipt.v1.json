    },
    "errorDetail": {
      "description": "daticert errore-esteso text",
      "type": "string"
    },
    "externalId": {
      "description": "Caller-supplied external ID, or null",
      "type": [
        "string",
        "null"
      ]
    },
    "messageId": {
      "description": "The receipt in the index (msg_…)",
      "type": "string"
    },
    "outboundId": {
      "description": "Linked outbound message, when EmailBridge sent the original",
      "type": "string"
    },
    "pecState": {
      "description": "Outbound PEC state after this receipt (S17 §5.2)",
      "type": "string"
    },
    "provider": {
      "description": "PEC provider that issued the receipt",
      "type": "string"
    },
    "receiptId": {
      "description": "rcp_…",
      "type": "string"
    },
    "receiptKind": {
      "description": "completa, breve or sintetica",
      "type": "string"
    },
    "recipients": {
      "description": "Addressees listed in daticert.xml",
      "items": {
        "$ref": "#/$defs/PECRecipient"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "refMessageIdHeader": {
      "description": "X-Riferimento-Message-ID: the original's Message-ID",
      "type": "string"
    },
    "sha256": {
      "description": "SHA-256 of the raw receipt (hex)",
      "type": "string"
    },
    "signature": {
      "$ref": "#/$defs/PECSignature",
      "description": "S/MIME check of the receipt"
    },
    "transportId": {
      "description": "PEC transport identifier (identificativo)",
      "type": "string"
    },
    "type": {
      "description": "accettazione, non-accettazione, presa-in-carico, avvenuta-consegna, errore-consegna, preavviso-errore-consegna, rilevazione-virus",
      "type": "string"
    }
