  "properties": {
    "data": {
      "description": "Event payload; its shape is the type's data schema (dataschema)"
    },
    "datacontenttype": {
      "description": "Media type of data, always application/json",
      "type": "string"
    },
    "dataschema": {
      "description": "URL of the JSON Schema of data (type and major version)",
      "type": "string"
    },
    "ebaccount": {
      "description": "Account ID (acc_…); omitted for organisation-level events",
      "type": "string"
    },
    "eborg": {
      "description": "Organisation ID (org_…)",
      "type": "string"
    },
    "ebschema": {
      "description": "Major version of the data schema",
      "format": "int64",
      "type": "integer"
    },
    "id": {
      "description": "Event ID (evt_…), unique and stable: deduplicate on it (deliveries are at least once)",
      "type": "string"
    },
    "source": {
      "description": "/organizations/{orgId} or /organizations/{orgId}/accounts/{accountId}",
      "type": "string"
    },
    "specversion": {
      "description": "CloudEvents version, always 1.0",
      "type": "string"
    },
    "subject": {
      "description": "ID of the resource the event is about (acc_…, msg_…, out_…, …)",
      "type": "string"
    },
    "time": {
      "description": "When the change happened (RFC 3339, millisecond precision, UTC)",
      "format": "date-time",
      "type": "string"
    },
    "traceparent": {
      "description": "W3C trace context of the change that produced the event",
      "type": "string"
    },
    "type": {
      "description": "Event type from the catalogue, e.g. message.received",
      "type": "string"
    }
  },
  "required": [
    "specversion",
    "id",
    "type",
    "source",
    "subject",
    "time",
    "datacontenttype",
    "dataschema",
    "eborg",
    "ebschema",
    "data"
  ],
  "title": "EmailBridge event envelope (CloudEvents 1.0)",
  "type": "object"
}
